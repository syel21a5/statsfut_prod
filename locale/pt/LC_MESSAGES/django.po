#: bakuplocal/0034_statsfut_backup_2026-07-21_13-23-29/matches/templates/matches/privacy_policy.html:43
msgid "Traffic analysis (Google Analytics)."
msgstr "Análise de tráfego (Google Analytics)."

#: bakuplocal/0034_statsfut_backup_2026-07-21_13-23-29/matches/templates/matches/privacy_policy.html:44
msgid "Ad personalization via advertising networks."
msgstr "Personalização de anúncios por meio de redes de publicidade."

#: bakuplocal/0034_statsfut_backup_2026-07-21_13-23-29/matches/templates/matches/privacy_policy.html:49
msgid "5. Security"
msgstr "5. Segurança"

#: bakuplocal/0034_statsfut_backup_2026-07-21_13-23-29/matches/templates/matches/privacy_policy.html:50
msgid ""
"We employ industry-standard security measures to protect information "
"processed on our site against unauthorized access, alteration, or "
"destruction."
msgstr ""
"Empregamos medidas de segurança padrão da indústria para proteger as "
"informações processadas em nosso site contra acesso não autorizado, "
